<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Form View -->
    <record id="view_softys_connector_form" model="ir.ui.view">
        <field name="name">softys.connector.form</field>
        <field name="model">softys.connector</field>
        <field name="arch" type="xml">
            <form string="Configuración Softys">
                <header>
                    <button name="action_export_manual" string="Exportar Ahora" type="object" class="oe_highlight"/>
                    <button name="action_send_now" string="Generar y Transmitir"
                            type="object" class="oe_highlight"
                            invisible="not sftp_enabled"
                            confirm="Los archivos se suben directo al portal productivo de Nextbyn. ¿Confirma la transmisión?"/>
                    <button name="action_test_sftp_connection" string="Probar Conexión SFTP"
                            type="object" invisible="not sftp_enabled"/>
                    <button name="action_view_exports" string="Ver Exportaciones" type="object"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="company_code"/>
                        <h1><field name="company_code" placeholder="001971"/></h1>
                    </div>
                    
                    <group>
                        <group string="Configuración Básica">
                            <field name="company_id"/>
                            <field name="softys_partner_id"/>
                            <field name="output_storage_type"/>
                            <field name="output_path"/>
                            <field name="days_back"/>
                        </group>
                        <group string="Estadísticas">
                            <field name="last_export_date"/>
                            <field name="last_export_status"/>
                            <field name="export_count"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Códigos Fijos">
                            <group>
                                <group>
                                    <field name="codigo_sucursal"/>
                                    <field name="codigo_fuerza"/>
                                    <field name="codigo_modo_atencion"/>
                                    <field name="codigo_deposito"/>
                                    <field name="codigo_ruta_default"/>
                                </group>
                                <group string="Defaults Localidad/Provincia (Anexo Nextbyn)">
                                    <field name="codigo_localidad_default"/>
                                    <field name="localidad_default"/>
                                    <field name="provincia_codigo_default"/>
                                    <field name="provincia_nombre_default"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Personal Comercial">
                            <field name="personal_comercial_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="codigo_personal"/>
                                    <field name="descripcion"/>
                                    <field name="cargo"/>
                                    <field name="anulado"/>
                                    <field name="codigo_personal_superior"/>
                                    <field name="codigo_fuerza"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Rutas de Venta">
                            <field name="ruta_venta_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="codigo_ruta"/>
                                    <field name="descripcion_ruta"/>
                                    <field name="codigo_personal"/>
                                    <field name="fecha_desde"/>
                                    <field name="atiende_lunes"/>
                                    <field name="atiende_martes"/>
                                    <field name="atiende_miercoles"/>
                                    <field name="atiende_jueves"/>
                                    <field name="atiende_viernes"/>
                                    <field name="atiende_sabado"/>
                                    <field name="atiende_domingo"/>
                                </list>
                            </field>
                        </page>
                        <page string="Valores por Defecto">
                            <div class="alert alert-info" role="alert">
                                Se aplican a los clientes que todavía no fueron
                                clasificados, para que los campos obligatorios del
                                archivo Clientes nunca viajen vacíos.
                            </div>
                            <group>
                                <field name="canal_default_id"/>
                                <field name="localidad_anexo_default_id"/>
                            </group>
                        </page>
                        <page string="Transmisión SFTP">
                            <group>
                                <group string="Conexión">
                                    <field name="sftp_enabled"/>
                                    <field name="sftp_host" invisible="not sftp_enabled"
                                           required="sftp_enabled"/>
                                    <field name="sftp_port" invisible="not sftp_enabled"/>
                                    <field name="sftp_user" invisible="not sftp_enabled"
                                           required="sftp_enabled"/>
                                    <field name="sftp_password" password="True"
                                           invisible="not sftp_enabled"
                                           required="sftp_enabled"/>
                                    <field name="sftp_path" invisible="not sftp_enabled"/>
                                    <field name="sftp_timeout" invisible="not sftp_enabled"/>
                                </group>
                                <group string="Última Transmisión" invisible="not sftp_enabled">
                                    <field name="sftp_last_send"/>
                                    <field name="sftp_last_status"/>
                                    <field name="sftp_last_message"/>
                                </group>
                            </group>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not sftp_enabled">
                                Todo lo que se transmite por SFTP va directo al portal
                                productivo de Nextbyn. La transmisión debe completarse
                                antes de las 23:30 de cada día.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="view_softys_connector_tree" model="ir.ui.view">
        <field name="name">softys.connector.list</field>
        <field name="model">softys.connector</field>
        <field name="arch" type="xml">
            <list string="Configuraciones Softys">
                <field name="company_code"/>
                <field name="company_id"/>
                <field name="last_export_date"/>
                <field name="last_export_status" widget="badge" 
                       decoration-success="last_export_status == 'success'"
                       decoration-warning="last_export_status == 'partial'"
                       decoration-danger="last_export_status == 'failed'"/>
                <field name="export_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_softys_connector" model="ir.actions.act_window">
        <field name="name">Configuración Softys</field>
        <field name="res_model">softys.connector</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear primera configuración Softys
            </p>
            <p>
                Configure los parámetros de integración con Softys.
            </p>
        </field>
    </record>
    
    <!-- Menu -->
    <menuitem id="menu_softys_connector"
              name="Conector"
              parent="menu_softys_config"
              action="action_softys_connector"
              sequence="10"/>
    
</odoo>
